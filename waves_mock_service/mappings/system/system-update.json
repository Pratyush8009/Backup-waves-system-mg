{
  "request": {
    "method": "PUT",
    "urlPathPattern": "/api/v1/waves/units/[a-zA-Z0-9-]+/systems/[a-zA-Z0-9-]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Headers": "Content-Type, Authorization",
      "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    },
    "bodyFileName": "success-updated-response.json",
    "transformers": [
      "response-template"
    ]
  }
}