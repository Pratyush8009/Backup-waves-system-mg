{
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v1/waves/unit/[a-zA-Z0-9-]+/system/[a-zA-Z0-9-]+/models/[a-zA-Z0-9-]+/plots"
  },
  "response": {
    "status": 200,
    "headers": {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Headers": "Content-Type, Authorization",
      "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    },
    "bodyFileName": "model-plots.json"
  }
}